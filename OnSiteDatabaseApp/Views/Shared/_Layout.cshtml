@using System.Security.Claims
@{
    var controller = ViewContext.RouteData.Values["controller"] as string;
    var action = ViewContext.RouteData.Values["action"] as string;
    var isLoggedIn = User.Identity != null && User.Identity.IsAuthenticated;
    var isAdmin = User.IsInRole("Admin");

    string Active(string controllerName, string actionName)
    {
        return controller == controllerName && action == actionName ? "active" : "";
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnSite Database</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/onsite.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnSiteApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark onsite-nav mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">OnSite</a>
                @if (isLoggedIn)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto gap-lg-1">
                            <li class="nav-item">
                                <a class="nav-link @Active("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Jobs", "Index")" asp-area="" asp-controller="Jobs" asp-action="Index">Today's Schedule</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @Active("Jobs", "Invoices")" asp-area="" asp-controller="Jobs" asp-action="Invoices">Invoices</a>
                            </li>
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @Active("Schedules", "Index")" asp-area="" asp-controller="Schedules" asp-action="Index">Manage Schedules</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @Active("Customers", "Index")" asp-area="" asp-controller="Customers" asp-action="Index">Customers</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @Active("Administrator", "Index")" asp-area="" asp-controller="Administrator" asp-action="Index">Administrator</a>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center gap-3 text-white">
                            <span class="fw-bold">@User.FindFirstValue("Label")</span>
                            <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-outline-light btn-sm">Change Password</a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                                <button type="submit" class="btn btn-outline-light btn-sm">Log Out</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - OnSite | Developed by Carlos Tapia | Version 2.1
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
