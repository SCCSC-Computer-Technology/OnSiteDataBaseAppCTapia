@model Job
@{
    ViewData["Title"] = "Job " + Model.Id;
    var percent = Model.Checklist.Count == 0 ? 0 : Model.DoneCount * 100 / Model.Checklist.Count;
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold">@TempData["Error"]</div>
}

<h1>Job #@Model.Id</h1>
<p class="mb-1">@Model.ClientName - @Model.Service</p>
<p class="mb-2">@Model.Address</p>
<p>
    <span class="badge text-bg-dark">@Model.StatusText</span>
    @if (Model.IsLate)
    {
        <span class="badge text-bg-danger">LATE</span>
    }
</p>

@if (Model.Status == JobStatus.Scheduled || Model.Status == JobStatus.EnRoute)
{
    <form asp-action="Navigate" asp-route-id="@Model.Id" method="post" class="mb-3">
        <button type="submit" class="btn btn-success btn-lg w-100 py-3">Start Navigation</button>
    </form>
    <form asp-action="Arrive" asp-route-id="@Model.Id" method="post" class="mb-3">
        <button type="submit" class="btn btn-primary btn-lg w-100 py-3">I Have Arrived</button>
    </form>
}

@if (Model.Status == JobStatus.InProgress || Model.Status == JobStatus.Completed)
{
    <h2 class="h4">Checklist (@Model.DoneCount / @Model.Checklist.Count)</h2>
    <div class="progress mb-3" style="height: 24px;">
        <div class="progress-bar bg-success" style="width: @percent%">@percent%</div>
    </div>

    <div class="list-group mb-3">
        @foreach (var item in Model.Checklist)
        {
            <form asp-action="Toggle" asp-route-id="@Model.Id" asp-route-itemId="@item.Id" method="post">
                <button type="submit"
                        class="list-group-item list-group-item-action d-flex justify-content-between fs-5 py-3 @(item.IsCompleted ? "list-group-item-success" : "")"
                        disabled="@(Model.Status == JobStatus.Completed)">
                    <span>@(item.IsCompleted ? "[X]" : "[ ]") @item.TaskLabel</span>
                    <span>@item.BillableValue.ToString("C")</span>
                </button>
            </form>
        }
    </div>

    <p class="fw-bold fs-5">Estimate total: @Model.Total.ToString("C")</p>

    @if (Model.Status == JobStatus.InProgress)
    {
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning fw-bold">@TempData["Warning"]</div>
            <form asp-action="Complete" asp-route-id="@Model.Id" asp-route-confirm="true" method="post" class="mb-3">
                <button type="submit" class="btn btn-danger btn-lg w-100 py-3">Yes, Complete Anyway</button>
            </form>
        }
        else
        {
            <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="mb-3">
                <button type="submit" class="btn btn-success btn-lg w-100 py-3">Complete Job &gt; Invoice</button>
            </form>
        }
    }
    else
    {
        <a asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-primary btn-lg w-100 py-3">View Invoice</a>
    }
}

<a asp-action="Index" class="btn btn-dark btn-lg w-100 mt-3">Back to Schedule</a>
